{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "composite": true,
        "noEmit": true,
        "strict": true,
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["vite.config.ts", "vitest.config.ts", "tailwind.config.ts", "eslint.config.js"]
}
